  "style13": {
    "_note": "Uses combined date-range strings ('years', 'period') instead of separate start/end fields — see joinFields. Experience has a single 'description' string, not a bullets array. Education uses 'university' instead of 'institution'. Socials live under contact.social, not footer.socials.",
    "scalar": {
      "fullName": "name",
      "jobTitle": "title",
      "summary": "about",
      "profileImage": "profile.image",
      "contact.email": "contact.email",
      "contact.phone": "contact.phone",
      "contact.location": "contact.address",
      "contact.website": "contact.website"
    },
    "arrays": {
      "skills": {
        "targetPath": "skills",
        "itemMap": {
          "name": "name",
          "level": "level"
        }
      },
      "languages": {
        "targetPath": "languages",
        "itemMap": {
          "name": "name",
          "level": "level"
        }
      },
      "experience": {
        "targetPath": "experience",
        "itemMap": {
          "jobTitle": "title",
          "company": "company",
          "bullets": "description",
          "joinBulletsAs": "paragraph"
        },
        "joinFields": [
          {
            "sourceFields": [
              "startDate",
              "endDate"
            ],
            "targetField": "period",
            "separator": " – "
          }
        ]
      },
      "education": {
        "targetPath": "education",
        "itemMap": {
          "degree": "degree",
          "institution": "university"
        },
        "joinFields": [
          {
            "sourceFields": [
              "startDate",
              "endDate"
            ],
            "targetField": "years",
            "separator": " – "
          }
        ]
      },
      "socialLinks": {
        "targetPath": "contact.social",
        "itemMap": {
          "platform": "name",
          "url": "url"
        },
        "inheritIconFrom": "contact.social"
      }
    },
    "clearIfBlank": {
      "socialLinks": [
        "contact.social"
      ]
    }
  },
  "style14": {
    "_note": "Skills are grouped by category ([{category,items:[...]}]) — the master form's optional 'category' field becomes a column (via groupedArrays groupBy); skills without one fall into a single 'Skills' group. Languages always get their own 'Languages' group. about.description is an array of paragraphs, not a single string — the one summary field is wrapped in a single-element array (via scalar's wrapInArray). about.stats cards come from the master 'stats' repeatable (value/label). The design's hero photo (hero.image) is replaced only when the master 'heroImage' is supplied; otherwise the template's own artwork stays. hero.title here is the person's TAGLINE/job title, not their name (profile.name holds the actual name). KNOWN LIMITATIONS: awards is a template-only bonus section not collected by the master form, left untouched. about.personal_info.availability (a status message) is also left as the template's own default, since only its sibling email/location fields are touched.",
    "scalar": {
      "fullName": "profile.name",
      "jobTitle": "hero.title",
      "summary": {
        "path": "about.description",
        "wrapInArray": true
      },
      "profileImage": "profile.image",
      "heroImage": {
        "path": "hero.image",
        "keepWhenBlank": true
      },
      "contact.email": "contact.email",
      "contact.phone": "contact.phone",
      "contact.location": "contact.location"
    },
    "compose": {
      "title": {
        "template": "{fullName} | {jobTitle}"
      },
      "footer.copyright": {
        "template": "© {year} {fullName}. All rights reserved."
      }
    },
    "arrays": {
      "experience": {
        "targetPath": "experience",
        "itemMap": {
          "jobTitle": "title",
          "company": "company",
          "bullets": "responsibilities"
        },
        "joinFields": [
          {
            "sourceFields": [
              "startDate",
              "endDate"
            ],
            "targetField": "date",
            "separator": " – "
          }
        ]
      },
      "education": {
        "targetPath": "education",
        "itemMap": {
          "degree": "title",
          "institution": "institution",
          "description": "description"
        },
        "joinFields": [
          {
            "sourceFields": [
              "startDate",
              "endDate"
            ],
            "targetField": "date",
